{
  "name": "unicode-regex",
  "type": "module",
  "version": "4.2.0",
  "description": "regular expression for matching unicode category",
  "keywords": [
    "regular-expression",
    "unicode"
  ],
  "exports": "./lib/index.js",
  "repository": "https://github.com/ikatyang-collab/unicode-regex",
  "homepage": "https://github.com/ikatyang-collab/unicode-regex#readme",
  "author": {
    "name": "Ika",
    "email": "ikatyang@gmail.com",
    "url": "https://github.com/ikatyang"
  },
  "license": "MIT",
  "scripts": {
    "prepack": "yarn build",
    "lint": "prettier . --check",
    "fix": "prettier . --write",
    "check": "tsc --noEmit",
    "test": "vitest",
    "build": "node ./scripts/generate.mjs && tsc -p ./tsconfig.build.json",
    "release": "release-it"
  },
  "dependencies": {
    "regexp-util": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@unicode/unicode-17.0.0": "2.0.7",
    "@vitest/coverage-v8": "5.0.0",
    "outdent": "^0.8.0",
    "prettier": "3.9.6",
    "release-it": "21.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "/lib/**/*",
    "/CHANGELOG.md",
    "/ThirdPartyNoticeText.txt"
  ],
  "packageManager": "yarn@4.18.0",
  "sideEffects": false
}
